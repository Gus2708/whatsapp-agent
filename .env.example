# ==========================================
# Configuración del Agente de WhatsApp
# ==========================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# n8n API
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_URL_LOCAL=http://127.0.0.1:5678/api/v1
N8N_API_KEY=your-n8n-api-key

# WAHA (WhatsApp HTTP API)
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=your-waha-api-key

# OpenRouter (Claude Sonnet 5 / Modelos de Automejora)
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenAI (Embeddings)
OPENAI_API_KEY=your-openai-api-key

# Notificaciones WhatsApp para Administradores (separados por coma)
ADMIN_PHONE_NUMBERS=584XXXXXXXXX@c.us,584YYYYYYYYY@c.us

# Personalización del Comercio (Opcional)
BOT_NAME="Perucho"
STORE_NAME="Ferretería El Serrucho"
TEST_PHONE_NUMBER=584XXXXXXXXX@c.us

# ------------------------------------------------------------------------------
# 5. Long-Term Customer Memory (Engram) & Experimental Context
# ------------------------------------------------------------------------------
ENGRAM_HOST=host.docker.internal:7437
## Experimental cable-only context (single-instance staging only; default off)
CONVERSATION_STATE_ENABLED=false

# Optional TypeSafe/Vercel Jev observation. off sends no requests; shadow is observational while routing is false.
# Customer free text is only best-effort redacted: validate in isolated staging first.
JEV_MODE=off
# Fast replies require true, canary scope and a matching inbound sender; leave false for observation.
JEV_ROUTING_ENABLED=false
# No broad routing scope is supported. Set to canary only for a single validated phone.
JEV_ROUTING_SCOPE=off
# E.164 phone, optionally prefixed with +; do not commit a real number.
JEV_CANARY_PHONE=
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
# Blank selects jev-1.13.0 for typesafe, typesafe-ai/jev for vercel.
JEV_MODEL=
JEV_TIMEOUT_MS=1500
JEV_MIN_CONFIDENCE=0.7
# Optional verified input-token USD price per million; blank means cost is unknown.
JEV_INPUT_USD_PER_MILLION=
