# ==========================================
# Configuración del Agente de WhatsApp
# ==========================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# n8n API
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_URL_LOCAL=http://127.0.0.1:5678/api/v1
N8N_API_KEY=your-n8n-api-key

# WAHA (WhatsApp HTTP API)
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=your-waha-api-key

# OpenRouter (Claude Sonnet 5 / Modelos de Automejora)
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenAI (Embeddings)
OPENAI_API_KEY=your-openai-api-key

# Notificaciones WhatsApp para Administradores (separados por coma)
ADMIN_PHONE_NUMBERS=584XXXXXXXXX@c.us,584YYYYYYYYY@c.us

# ==============================================================================
# Personalización de Identidad y Comercio
# ==============================================================================
BOT_NAME="Perucho"
BOT_ROLE="asesor ferretero experto"
BOT_EMOJIS="👨🏻‍🔧 🪚"

STORE_NAME="Ferretería El Serrucho"
STORE_SHORT_NAME="El Serrucho"
STORE_COUNTRY="Venezuela"
STORE_STATE="Estado Falcón"
STORE_CITY="Mene Mauroa"
STORE_LOCATION="Estamos ubicados en Mene Mauroa, Estado Falcón, Venezuela."

STORE_HOURS="Atendemos de lunes a sábado de 8:00 AM a 6:00 PM (con descanso para almuerzo de 1:00 PM a 2:00 PM). Domingos y feriados permanecemos cerrados."
STORE_DELIVERY_POLICY="Puedes retirar compras generales en la tienda física. Todo lo que es hierros (tubos, láminas, cerchas, cabillas, etc.) y cemento está en nuestro galpón aparte en La Compañía; allí se retiran y de allí salen los envíos. Contamos con transporte de materiales a $10 en el centro de Mene Mauroa (fuera del Mene debe preguntar). En cualquier caso, antes de pagar el envío el cliente siempre debe hablar con un empleado."
STORE_PAYMENTS="Aceptamos pagos en dólares en efectivo (USD), bolívares en efectivo, Pago Móvil y transferencia bancaria a la tasa oficial del Banco Central de Venezuela (BCV). También aceptamos Zelle para compras a partir de $20.00 USD. Para concretar el pago, un empleado te atiende enseguida o puedes pasar por la tienda física."
STORE_RETURNS="Aceptamos cambios y devoluciones hasta 7 días continuos desde la fecha de compra, presentando el producto sellado en su empaque original y la factura de compra."

# Infraestructura y Contenedores
# CONTAINER_PREFIX=
WAHA_INTERNAL_URL=http://waha:3000
N8N_INTERNAL_URL=http://n8n:5678
TEST_PHONE_NUMBER=584XXXXXXXXX@c.us

# ------------------------------------------------------------------------------
# 5. Long-Term Customer Memory (Engram) & Experimental Context
# ------------------------------------------------------------------------------
ENGRAM_HOST=host.docker.internal:7437
## Experimental cable-only context (single-instance staging only; default off)
CONVERSATION_STATE_ENABLED=false

# Optional TypeSafe/Vercel Jev observation. off sends no requests; shadow is observational while routing is false.
# Customer free text is only best-effort redacted: validate in isolated staging first.
JEV_MODE=off
# Fast replies require true and an explicit canary or all scope; leave false for observation.
JEV_ROUTING_ENABLED=false
# off (default), canary (one validated phone), or all (valid inbound private JIDs only).
# Use all only after deploying the matching workflow and validating the canary.
JEV_ROUTING_SCOPE=off
# E.164 phone, optionally prefixed with +; do not commit a real number.
JEV_CANARY_PHONE=
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
# Blank selects jev-1.13.0 for typesafe, typesafe-ai/jev for vercel.
JEV_MODEL=
JEV_TIMEOUT_MS=1500
JEV_MIN_CONFIDENCE=0.7
# Optional verified input-token USD price per million; blank means cost is unknown.
JEV_INPUT_USD_PER_MILLION=
# Separate product-search qualifier: off (default), shadow (observe), enforce (filter).
# Requires JEV_PROVIDER=vercel, JEV_MODEL=typesafe-ai/jev and AI_GATEWAY_API_KEY.
JEV_PRODUCT_QUALIFIER_MODE=off
