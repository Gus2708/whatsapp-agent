# ==============================================================================
# WhatsApp AI Sales Agent - Environment Configuration (.env)
# Copy this file to .env and configure the values for your business.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Business & Agent Persona Branding (Dynamic White-Label)
# ------------------------------------------------------------------------------
AGENT_NAME="Sales Agent"
STORE_NAME="Commerce Store"
STORE_LOCATION="Downtown Branch, Main City"
STORE_SCHEDULE="Monday to Saturday: 8:00 AM - 6:00 PM"
STORE_CURRENCY="USD"

# Public variables for Dashboard / CRM (Next.js)
NEXT_PUBLIC_AGENT_NAME="Sales Agent"
NEXT_PUBLIC_STORE_NAME="Commerce Store"

# ------------------------------------------------------------------------------
# 2. WhatsApp HTTP API (WAHA - WhatsApp HTTP API)
# ------------------------------------------------------------------------------
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change_this_password
WAHA_API_KEY=your_secure_waha_api_key_here

# ------------------------------------------------------------------------------
# 3. LLM & Audio Providers
# ------------------------------------------------------------------------------
# OpenRouter API Key for main reasoning / agent orchestrator (e.g. gpt-4o, claude, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API Key for real-time speech-to-text voice notes transcription (<800ms Whisper)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional: for pgvector embeddings text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 4. Database & Storage (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 5. Long-Term Customer Memory (Engram)
# ------------------------------------------------------------------------------
ENGRAM_HOST=host.docker.internal:7437
