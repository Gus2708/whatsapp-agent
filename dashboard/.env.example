# ==============================================================================
# WHATSAPP AGENT FLIGHT DECK — VERCEL ENVIRONMENT VARIABLES
# ==============================================================================
# Configura estas variables en tu proyecto de Vercel (Project Settings -> Environment Variables)
# NINGUNA de estas variables debe ser hardcodeada en el código fuente.

# Supabase Database (PostgreSQL + pgvector + RAG 5 Layers)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# OpenRouter / Inferencia LLM
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# OpenAI Embeddings (text-embedding-3-small para Capa 4 pgvector)
OPENAI_API_KEY=sk-your_openai_api_key_here
