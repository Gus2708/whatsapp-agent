# ==============================================================================
# VERCEL & NEXT.JS ENVIRONMENT CONFIGURATION - FLIGHT DECK CRM
# ==============================================================================

# Supabase Auth & Database (Obligatorio)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Nombre del Agente en el HUD
NEXT_PUBLIC_AGENT_NAME=Sales Agent
NEXT_PUBLIC_STORE_NAME=Commerce Store

# Orquestador n8n (Telemetría de workflows & ejecuciones)
N8N_API_URL=http://localhost:5678
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_jwt_key_here

# Pasarela WhatsApp (WAHA)
WAHA_API_KEY=your_secure_waha_api_key_here
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=your_waha_password_here

# LLMs y Embeddings (RAG 5 Capas)
OPENROUTER_API_KEY=sk-or-v1-...
OPENAI_API_KEY=sk-proj-...
